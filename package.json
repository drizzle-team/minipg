{
  "name": "minipg",
  "version": "0.1.0",
  "description": "A minimal, dependency-free PostgreSQL driver for Node, Bun, Deno, and Cloudflare Workers.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/drizzle-team/minipg.git"
  },
  "homepage": "https://github.com/drizzle-team/minipg#readme",
  "bugs": {
    "url": "https://github.com/drizzle-team/minipg/issues"
  },
  "keywords": [
    "postgres",
    "postgresql",
    "pg",
    "database",
    "driver",
    "cloudflare-workers",
    "hyperdrive",
    "deno",
    "bun",
    "edge"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    },
    "./deno": {
      "types": "./dist/deno.d.ts",
      "import": "./dist/deno.js"
    },
    "./cf": {
      "types": "./dist/cf.d.ts",
      "import": "./dist/cf.js"
    },
    "./telemetry": {
      "types": "./dist/telemetry.d.ts",
      "import": "./dist/telemetry.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsdown",
    "prepublishOnly": "bun run typecheck && bun run build",
    "typecheck": "tsc --noEmit",
    "test": "bun test test/unit test/integration",
    "test:unit": "bun test test/unit",
    "test:integration": "bun test test/integration",
    "test:cf": "vitest run --config test/cf/vitest.config.ts",
    "test:query": "bun test test/integration/results.test.ts test/integration/types-core.test.ts test/integration/types-advanced.test.ts test/integration/types-temporal-json.test.ts test/integration/parameters.test.ts test/integration/query-protocol.test.ts test/integration/prepared-statements.test.ts test/integration/regression.test.ts",
    "test:query:interp": "MINIPG_VARIANT=interpreted bun run test:query",
    "test:query:both": "bun run test:query && bun run test:query:interp",
    "test:smoke": "bun test/smoke.ts",
    "test:setup": "bash test/setup-pg.sh",
    "bench": "bun bench/drivers.bench.ts",
    "bench:micro": "bun bench/micro.bench.ts",
    "bench:overhead": "bun bench/overhead.bench.ts",
    "bench:json": "bun bench/json-decode.bench.ts",
    "bench:json-shape": "bun bench/json-shape.bench.ts",
    "demo:codegen": "bun codegen-demo.ts",
    "bench:decode-vs": "bun bench/decode-vs.bench.ts",
    "bench:parity": "bun bench/decode-parity.ts",
    "bench:float": "bun bench/float-decode.bench.ts",
    "bench:temporal": "bun bench/temporal-decode.bench.ts",
    "bench:binary": "bun bench/binary-vs-text.bench.ts",
    "bench:pertype": "bun bench/per-type-decode.bench.ts",
    "bench:chunks": "bun bench/chunks.bench.ts",
    "bench:mapper-dispatch": "bun bench/mapper-dispatch.bench.ts"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.5.2",
    "@mitata/counters": "^0.0.8",
    "@types/bun": "latest",
    "@types/pg": "^8.20.0",
    "cli-highlight": "^2.1.11",
    "fast-check": "^4.8.0",
    "mitata": "^1.0.34",
    "pg": "^8.22.0",
    "postgres": "^3.4.9",
    "prettier": "^3.9.1",
    "tsdown": "^0.22.3",
    "vitest": "~2.1.9",
    "wrangler": "^3.90.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
