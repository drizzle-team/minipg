{
  "name": "nodepg-postgresjs",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:unit": "bun test test/unit",
    "test:integration": "bun test test/integration",
    "test:query": "bun test test/integration/results.test.ts test/integration/types-core.test.ts test/integration/types-advanced.test.ts test/integration/types-temporal-json.test.ts test/integration/parameters.test.ts test/integration/query-protocol.test.ts test/integration/prepared-statements.test.ts test/integration/regression.test.ts",
    "test:query:jit": "MINIPG_VARIANT=jit bun run test:query",
    "test:query:both": "bun run test:query && bun run test:query:jit",
    "test:smoke": "bun test/smoke.ts",
    "test:setup": "bash test/setup-pg.sh",
    "bench": "bun bench/drivers.bench.ts",
    "bench:micro": "bun bench/micro.bench.ts",
    "bench:overhead": "bun bench/overhead.bench.ts",
    "bench:json": "bun bench/json-decode.bench.ts",
    "bench:json-shape": "bun bench/json-shape.bench.ts",
    "demo:codegen": "bun codegen-demo.ts",
    "bench:decode-vs": "bun bench/decode-vs.bench.ts",
    "bench:parity": "bun bench/decode-parity.ts",
    "bench:mapper": "bun bench/mapper.bench.ts",
    "bench:float": "bun bench/float-decode.bench.ts",
    "bench:temporal": "bun bench/temporal-decode.bench.ts",
    "bench:binary": "bun bench/binary-vs-text.bench.ts",
    "bench:pertype": "bun bench/per-type-decode.bench.ts",
    "bench:chunks": "bun bench/chunks.bench.ts"
  },
  "devDependencies": {
    "@mitata/counters": "^0.0.8",
    "@types/bun": "latest",
    "@types/pg": "^8.20.0",
    "cli-highlight": "^2.1.11",
    "fast-check": "^4.8.0",
    "mitata": "^1.0.34",
    "pg": "^8.22.0",
    "postgres": "^3.4.9",
    "prettier": "^3.9.1"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
